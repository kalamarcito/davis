{% extends 'base.html.twig' %}
{% set menu = 'resources' %}

{% block body %}

{% include '_partials/back_button.html.twig' with { url: path('user_index'), text: "users.back"|trans } %}

<h1 class="display-4 d-flex fw-lighter justify-content-between">{{ "addressbooks.for"|trans({'who': principal.displayName}) }} <a href="{{ path('addressbook_create', {userId: userId}) }}" class="btn btn-sm btn-success mb-auto mt-auto">+ {{ "addressbooks.new"|trans }}</a></h1>

<div class="list-group mt-4">
{% for addressbook_instance in addressbook_instances %}
    <div class="list-group-item p-3">
        <div class="d-flex w-100 justify-content-between">
            <h5 class="mb-1 me-auto">{{ addressbook_instance.displayName }}</h5>
            <div class="me-0 text-right d-md-block d-none">
                <a href="#"
                    data-bs-toggle="modal" data-bs-target="#shareModal"
                    data-sharees-href="{{ path('addressbook_shares',{userId: userId, addressbookid: addressbook_instance.addressBook.id})}}"
                    data-href="{{ path('addressbook_share_add', {userId: userId, instanceid: addressbook_instance.id}) }}"
                    class="btn btn-sm btn-outline-info ms-1 share-modal"
                >🔗 {{ "sharing"|trans }}</a>
                <a href="{{ path('addressbook_edit',{userId: userId, id: addressbook_instance.id})}}" class="btn btn-sm btn-outline-primary ms-1">✎ {{ "edit"|trans }}</a>
                <a href="#"
                    data-bs-toggle="modal" data-bs-target="#deleteModal-addressbooks"
                    data-href="{{ path('addressbook_delete',{userId: userId, id: addressbook_instance.id})}}"
                    class="btn btn-sm btn-outline-danger ms-1" 
                    data-flavour="addressbooks"
                >⚠ {{ "delete"|trans }}</a>
            </div>
        </div>
        <p class="mb-1">{{ addressbook_instance.description }}</p>
        <small>{{ "addressbooks.uri"|trans }} : <code>{{ addressbook_instance.uri }}</code> — {{ "addressbooks.contacts"|trans({'%count%': addressbook_instance.addressBook.cards|length}) }}</small>
        <div class="btn-group btn-group-sm mt-3 d-flex d-md-none" role="group">
            <a href="#"
                data-bs-toggle="modal" data-bs-target="#shareModal"
                data-sharees-href="{{ path('addressbook_shares',{userId: userId, addressbookid: addressbook_instance.addressBook.id})}}"
                data-href="{{ path('addressbook_share_add', {userId: userId, instanceid: addressbook_instance.id}) }}"
                class="btn btn-outline-info share-modal"
            >🔗 {{ "sharing"|trans }}</a>
            <a href="{{ path('addressbook_edit',{userId: userId, id: addressbook_instance.id})}}" class="btn btn-sm btn-outline-primary">✎ {{ "edit"|trans }}</a>
            <a href="#"
                data-bs-toggle="modal" data-bs-target="#deleteModal-addressbooks"
                data-href="{{ path('addressbook_delete',{userId: userId, id: addressbook_instance.id})}}"
                class="btn btn-sm btn-outline-danger"
                data-flavour="addressbooks"
            >⚠ {{ "delete"|trans }}</a>
        </div>
    </div>
{% endfor %}
</div>

{% if shared_instances|length > 0 %}
    <h2 class="h4 mt-5 fw-lighter">{{ "addressbooks.shared.with"|trans({'who': principal.displayName}) }}</h2>

    <div class="list-group mt-3">
    {% for row in shared_instances %}
        {% set addressbook_instance = row.entity %}
        {% set viaGroup = row.viaGroup %}
        <div class="list-group-item p-3">
            <div class="d-flex w-100 justify-content-between">
                <h5 class="mb-1 me-auto">
                    {{ addressbook_instance.displayName }}
                    {% if addressbook_instance.access == 2 %}
                        <span class="badge bg-info ms-1">{{ "addressbook.share_access.2"|trans }}</span>
                    {% elseif addressbook_instance.access == 3 %}
                        <span class="badge bg-success ms-1">{{ "addressbook.share_access.3"|trans }}</span>
                    {% endif %}
                    {% if viaGroup %}
                        <span class="badge bg-secondary ms-1">👥 {{ "sharing.via_group"|trans({'name': viaGroup.displayName}) }}</span>
                    {% endif %}
                </h5>
                <div class="me-0 text-right d-md-block d-none">
                    {% if not viaGroup %}
                    <a href="{{ path('addressbook_edit',{userId: userId, id: addressbook_instance.id})}}" class="btn btn-sm btn-outline-primary ms-1">✎ {{ "edit"|trans }}</a>
                    <a href="#"
                        data-bs-toggle="modal" data-bs-target="#deleteModal-revoke"
                        data-href="{{ path('addressbook_revoke',{userId: userId, id: addressbook_instance.id})}}"
                        data-flavour="revoke"
                        class="btn btn-sm btn-outline-danger ms-1"
                    >🚫 {{ "revoke"|trans }}</a>
                    {% else %}
                    <span class="text-muted small">{{ "sharing.via_group.hint"|trans }}</span>
                    {% endif %}
                </div>
            </div>
            <p class="mb-1">{{ addressbook_instance.description }}</p>
            <small>{{ "addressbooks.uri"|trans }} : <code>{{ addressbook_instance.uri }}</code> — {{ "addressbooks.contacts"|trans({'%count%': addressbook_instance.addressBook.cards|length}) }}</small>
            {% if not viaGroup %}
            <div class="btn-group btn-group-sm mt-3 d-flex d-md-none" role="group">
                <a href="{{ path('addressbook_edit',{userId: userId, id: addressbook_instance.id})}}" class="btn btn-outline-primary">✎ {{ "edit"|trans }}</a>
                <a href="#"
                    data-bs-toggle="modal" data-bs-target="#deleteModal-revoke"
                    data-href="{{ path('addressbook_revoke',{userId: userId, id: addressbook_instance.id})}}"
                    data-flavour="revoke"
                    class="btn btn-outline-danger"
                >🚫 {{ "revoke"|trans }}</a>
            </div>
            {% endif %}
        </div>
    {% endfor %}
    </div>

    {% include '_partials/delete_modal.html.twig' with {flavour: 'revoke'} %}
{% endif %}

{% include '_partials/share_modal.html.twig' with {principals: allPrincipals} %}
{% include '_partials/delete_modal.html.twig' with {flavour: 'addressbooks'} %}

{% endblock %}
