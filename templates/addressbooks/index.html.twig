{% extends 'base.html.twig' %}
{% set menu = 'resources' %}

{% block body %}

{% include '_partials/back_button.html.twig' with { url: path('user_index'), text: "users.back"|trans } %}

<h1 class="display-4 d-flex fw-lighter justify-content-between">{{ "addressbooks.for"|trans({'who': principal.displayName}) }} <a href="{{ path('addressbook_create', {username: username}) }}" class="btn btn-sm btn-success mb-auto mt-auto">+ {{ "addressbooks.new"|trans }}</a></h1>

<div class="list-group mt-4">
{% for addressbook_instance in addressbook_instances %}
    <div class="list-group-item p-3">
        <div class="d-flex w-100 justify-content-between">
            <h5 class="mb-1 me-auto">{{ addressbook_instance.displayName }} {% if addressbook_instance.isShared() %}<span class="badge bg-info">Shared</span>{% endif %}</h5>
            <div class="me-0 text-right d-md-block d-none">
                <a href="#"
                    data-bs-toggle="modal" data-bs-target="#shareModal"
                    data-sharees-href="{{ path('addressbook_shares',{username: username, addressbookid: addressbook_instance.addressBook.id})}}"
                    data-href="{{ path('addressbook_share_add', {username: username, instanceid: addressbook_instance.id}) }}"
                    class="btn btn-sm btn-outline-info ms-1 share-modal"
                >🔗 {{ "sharing"|trans }}</a>
                <a href="{{ path('addressbook_edit',{username: username, id: addressbook_instance.id})}}" class="btn btn-sm btn-outline-primary ms-1">✎ {{ "edit"|trans }}</a>
                <a href="#"
                    data-bs-toggle="modal" data-bs-target="#deleteModal-addressbooks"
                    data-href="{{ path('addressbook_delete',{username: username, id: addressbook_instance.id})}}"
                    class="btn btn-sm btn-outline-danger ms-1" 
                    data-flavour="addressbooks"
                >⚠ {{ "delete"|trans }}</a>
            </div>
        </div>
        <p class="mb-1">{{ addressbook_instance.description }}</p>
        <small>{{ "addressbooks.uri"|trans }} : <code>{{ addressbook_instance.uri }}</code> — {{ "addressbooks.contacts"|trans({'%count%': addressbook_instance.addressBook.cards|length}) }}
        {% if addressbook_instance.isShared() %}
            <br>Access Level: 
            {% if addressbook_instance.access == 2 %}
                <span class="badge bg-secondary">Read Only</span>
            {% elseif addressbook_instance.access == 3 %}
                <span class="badge bg-primary">Read/Write</span>
            {% endif %}
        {% endif %}</small>
        <div class="btn-group btn-group-sm mt-3 d-flex d-md-none" role="group">
            <a href="#"
                data-bs-toggle="modal" data-bs-target="#shareModal"
                data-sharees-href="{{ path('addressbook_shares',{username: username, addressbookid: addressbook_instance.addressBook.id})}}"
                data-href="{{ path('addressbook_share_add', {username: username, instanceid: addressbook_instance.id}) }}"
                class="btn btn-outline-info share-modal"
            >🔗 {{ "sharing"|trans }}</a>
            <a href="{{ path('addressbook_edit',{username: username, id: addressbook_instance.id})}}" class="btn btn-sm btn-outline-primary">✎ {{ "edit"|trans }}</a>
            <a href="#"
                data-bs-toggle="modal" data-bs-target="#deleteModal-addressbooks"
                data-href="{{ path('addressbook_delete',{username: username, id: addressbook_instance.id})}}" 
                class="btn btn-sm btn-outline-danger"
                data-flavour="addressbooks"
            >⚠ {{ "delete"|trans }}</a>
        </div>
    </div>
{% endfor %}
</div>

{% include '_partials/share_modal.html.twig' with {principals: allPrincipals} %}
{% include '_partials/delete_modal.html.twig' with {flavour: 'addressbooks'} %}

{% endblock %}